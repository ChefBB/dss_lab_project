import json
import csv
import os

# ============================================================
# 0) PATH INPUT / OUTPUT  (IDENTICI AI TUOI)
# ============================================================

BASE = r"C:\Users\Win10\OneDrive - Università degli Studi di Torino\Desktop\repo_dss\dss_lab_project"

ARTISTS_PATH = os.path.join(BASE, r"dataset\Finali\artistsFinal.json")
TRACKS_PATH  = os.path.join(BASE, r"dataset\Finali\tracksFinal.json")
PART_PATH    = os.path.join(BASE, r"dataset\Finali\participationsFinal.json")

OUT_DIR = os.path.join(BASE, r"dataset\Assignment5_CSV")
os.makedirs(OUT_DIR, exist_ok=True)

# ============================================================
# 1) LOAD CLEAN DATASETS
# ============================================================

artists = json.load(open(ARTISTS_PATH, "r", encoding="utf-8"))
tracks  = json.load(open(TRACKS_PATH,  "r", encoding="utf-8"))
parts   = json.load(open(PART_PATH,   "r", encoding="utf-8"))

print("✔ Loaded datasets:")
print(" Artists:", len(artists))
print(" Tracks:", len(tracks))
print(" Participation:", len(parts))


# ============================================================
# FUNZIONE: CALCOLARE LA STAGIONE
# ============================================================

def get_season(month, day):
    if month == "NULL" or day == "NULL":
        return "NULL"

    m = int(month)
    d = int(day)

    if (m == 12 and d >= 21) or (1 <= m <= 2) or (m == 3 and d < 21):
        return "Winter"
    elif (m == 3 and d >= 21) or (4 <= m <= 5) or (m == 6 and d < 21):
        return "Spring"
    elif (m == 6 and d >= 21) or (7 <= m <= 8) or (m == 9 and d < 23):
        return "Summer"
    else:
        return "Autumn"


# ============================================================
# 2) DIMDATE
# ============================================================

date_map = {}

for t in tracks:
    dk = t["date_id"]
    if dk == "NULL":
        continue

    y, m, d = t["year"], t["month"], t["day"]
    q = (m - 1) // 3 + 1 if m != "NULL" else "NULL"
    season = get_season(m, d)

    if dk not in date_map:
        date_map[dk] = (y, m, d, q, season)

with open(os.path.join(OUT_DIR, "DimDate.csv"), "w", newline="", encoding="utf-8") as f:
    w = csv.writer(f)
    w.writerow(["DateKey","Year","Month","Day","Quarter","Season"])
    for dk, row in date_map.items():
        w.writerow([dk] + list(row))

print("✔ DimDate.csv written")


# ============================================================
# 3) DIM ARTIST GEOGRAPHY
# ============================================================

geo_map = {}
geo_list = []
counter = 1

def geo_tuple(a):
    return (
        a["province"],
        a["region"],
        a["country"],
        a["latitude"],
        a["longitude"]
    )

for a in artists:
    tup = geo_tuple(a)
    if tup not in geo_map:
        key = f"GEO_{counter}"
        geo_map[tup] = key
        geo_list.append([key] + list(tup))
        counter += 1

with open(os.path.join(OUT_DIR, "DimArtistGeography.csv"), "w", newline="", encoding="utf-8") as f:
    w = csv.writer(f)
    w.writerow(["GeoKey","Province","Region","Country","Latitude","Longitude"])
    for r in geo_list:
        w.writerow(r)

print("✔ DimArtistGeography.csv written")


# ============================================================
# 4) DIM ARTIST
# ============================================================

with open(os.path.join(OUT_DIR, "DimArtist.csv"), "w", newline="", encoding="utf-8") as f:
    w = csv.writer(f)

    w.writerow([
        "ArtistKey","Name","Gender","BirthDate","BirthPlace","Nationality",
        "Description","ActiveStart","ActiveEnd","Type","GeoKey"
    ])

    for a in artists:
        geokey = geo_map[geo_tuple(a)]
        w.writerow([
            a["new_id_artist"],
            a["name"],
            a["gender"],
            a["birth_date"],
            a["birth_place"],
            a["nationality"],
            a["description"],
            a["active_start"],
            a["active_end"],
            a["type"],
            geokey
        ])

print("✔ DimArtist.csv written")


# ============================================================
# 5) DIM ALBUM
# ============================================================

album_map = {}

for t in tracks:
    alb = t["new_id_album"]
    if alb not in album_map:
        album_map[alb] = [
            t["album_name"],
            t["album_release_date"],
            t["album_type"]
        ]

with open(os.path.join(OUT_DIR, "DimAlbum.csv"), "w", newline="", encoding="utf-8") as f:
    w = csv.writer(f)
    w.writerow(["AlbumKey","AlbumName","ReleaseDate","AlbumType"])
    for k, r in album_map.items():
        w.writerow([k] + r)

print("✔ DimAlbum.csv written")


# ============================================================
# 6) DIM LYRICS (FIX INT!)
# ============================================================

with open(os.path.join(OUT_DIR, "DimLyrics.csv"), "w", newline="", encoding="utf-8") as f:
    w = csv.writer(f)

    w.writerow([
        "LyricsKey","Language","Swear_IT","Swear_EN","Swear_IT_Words","Swear_EN_Words",
        "NSentences","NTokens","CharPerToken","AvgTokenPerClause","Explicit","LyricsText"
    ])

    for t in tracks:
        ns = int(t["n_sentences"]) if t["n_sentences"] != "NULL" else None
        nt = int(t["n_tokens"]) if t["n_tokens"] != "NULL" else None
        explicit_flag = 1 if t["explicit"] == True else 0

        w.writerow([
            t["lyrics_id"],
            t["language"],
            t["swear_IT"],
            t["swear_EN"],
            t["swear_IT_words"],
            t["swear_EN_words"],
            ns,
            nt,
            t["char_per_tok"],
            t["avg_token_per_clause"],
            explicit_flag,
            t["lyrics"]
        ])

print("✔ DimLyrics.csv written")


