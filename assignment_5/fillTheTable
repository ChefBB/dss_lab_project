# ============================================================
# 9) FACT PARTICIPATION
# ============================================================

with open(os.path.join(OUT_DIR, "FactParticipation.csv"), "w", newline="", encoding="utf-8") as f:
    w = csv.writer(f)
    w.writerow(["SongKey","ArtistKey","DateKey","Streams1Month","IsPrimary"])

    for p in parts:
        # find track
        tr = next((t for t in tracks if t["new_track_id"] == p["new_track_id"]), None)
        if tr:
            w.writerow([
                p["new_track_id"],
                p["new_id_artist"],
                tr["date_id"],
                tr["streams@1month"],
                p["IsPrimary"]
            ])

