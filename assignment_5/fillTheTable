import json
import csv
from datetime import datetime

# ============================
# PATH DEI FILE
# ============================

DATASET_PATH = r"C:\Users\Win10\OneDrive - Università degli Studi di Torino\Desktop\repo_dss\dss_lab_project\dataset"
OUTPUT_PATH = DATASET_PATH

TRACKS_PATH = f"{DATASET_PATH}\\tracks_nullclean.json"
ARTISTS_PATH = f"{DATASET_PATH}\\artists_filled.json"


# ============================
# LOAD FILE JSON
# ============================

with open(TRACKS_PATH, "r", encoding="utf-8") as f:
    tracks = json.load(f)

with open(ARTISTS_PATH, "r", encoding="utf-8") as f:
    artists = json.load(f)


# ============================
# FUNZIONE PER SALVARE CSV
# ============================

def write_csv(filename, fieldnames, rows):
    with open(filename, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)



# ===========================================================
# 1) DIM ARTIST GEOGRAPHY  
# ===========================================================

geo_set = {}

for a in artists:
    key = (a.get("province"), a.get("region"), a.get("country"))
    if key not in geo_set:
        geo_set[key] = {
            "BirthCity": a.get("province"),
            "BirthRegion": a.get("region"),
            "BirthCountry": a.get("country"),
            "Latitude": a.get("latitude"),
            "Longitude": a.get("longitude")
        }

dim_artist_geo_rows = list(geo_set.values())


# ===========================================================
# 2) DIM ARTIST
# ===========================================================

dim_artist_rows = []

for a in artists:
    # cerco la geography_key “logica”: è la posizione nella lista deduplicata
    geo_key = None
    for idx, g in enumerate(dim_artist_geo_rows, start=1):
        if (
            g["BirthCity"] == a.get("province") and
            g["BirthRegion"] == a.get("region") and
            g["BirthCountry"] == a.get("country")
        ):
            geo_key = idx
            break

    dim_artist_rows.append({
        "ArtistID_Original": a["id_author"],
        "ArtistName": a["name"],
        "Gender": a.get("gender"),
        "BirthDate": a.get("birth_date"),
        "BirthPlace": a.get("birth_place"),
        "Nationality": a.get("nationality"),
        "Description": a.get("description"),
        "ActiveStartDate": a.get("active_start"),
        "ActiveEndDate": a.get("active_end"),
        "Type":a.get("type"),
        "ArtistGeoKey": geo_key
    })


# ===========================================================
# 3) DIM ALBUM
# ===========================================================

album_map = {}

for t in tracks:
    alb = t.get("id_album")
    if alb and alb not in album_map:
        album_map[alb] = {
            "AlbumID_Original": alb, #chiedere se prende id album originale
            "AlbumName": t.get("album_name"),
            "AlbumType": t.get("album_type"),
            "AlbumReleaseDate": t.get("album_release_date")
        }

dim_album_rows = list(album_map.values())


# ===========================================================
# 4) DIM DATE
# ===========================================================

date_map = {}

# Funzione per determinare la stagione --> vedere meglio i giorni precisi
def get_season(m):
    if m in [12,1,2]: return "Winter"
    if m in [3,4,5]: return "Spring"
    if m in [6,7,8]: return "Summer"
    return "Autumn"

for t in tracks:
    y, m, d = t.get("year"), t.get("month"), t.get("day")
    if y and m and d:
        full_date = f"{int(y):04d}-{int(m):02d}-{int(d):02d}"

        if full_date not in date_map:
            dt = datetime(int(y), int(m), int(d))
            date_map[full_date] = {
                "FullDate": full_date,
                "Day": dt.day, #ma questa lo prende da track? 
                "Month": dt.month,
                "MonthName": dt.strftime("%B"),
                "Year": dt.year,
                "Season": get_season(dt.month)
            }

dim_date_rows = list(date_map.values())


# ===========================================================
# 5) FACT PUBLISHED SONG
# ===========================================================

fact_rows = []

for t in tracks:
    y, m, d = t.get("year"), t.get("month"), t.get("day")

    if y and m and d:
        full_date = f"{int(y):04d}-{int(m):02d}-{int(d):02d}"
    else:
        continue  # salta righe senza data

    fact_rows.append({
        "SongID_Original": t["id"],
        "ArtistID_Original": t["id_artist"],
        "AlbumID_Original": t.get("id_album"),
        "FullDate": full_date,

        "SongTitle": t.get("title"),
        "Language": t.get("language"),
        "DurationMS": t.get("duration_ms"),
        "Explicit": t.get("explicit"),
        "Popularity": t.get("popularity"),
        "TrackNumber": t.get("track_number"),
        "Category": None,
        "LyricsText": t.get("lyrics"),

        "NSentences": t.get("n_sentences"),
        "NTokens": t.get("n_tokens"),
        "CharPerToken": t.get("char_per_tok"),
        "AvgTokenPerClause": t.get("avg_token_per_clause"),

        "Swear_IT": t.get("swear_IT"),
        "Swear_EN": t.get("swear_EN"),
        "Swear_IT_Words": t.get("swear_IT_words"),
        "Swear_EN_Words": t.get("swear_EN_words"),

        "BPM": t.get("bpm"),
        "RMS": t.get("rms"),
        "Pitch": t.get("pitch"),
        "SpectralComplexity": t.get("spectral_complexity"),
        "Loudness": t.get("loudness"),
        "Rolloff": t.get("rolloff"),
        "Flux": t.get("flux"),
        "Flatness": t.get("flatness"),

        "StreamsAfter1Month": t.get("streams@1month")
    })


# ===========================================================
# 6) BRIDGE SONG - ARTIST 
# ===========================================================

bridge_rows = []

# Mappa nome → ID
name_to_id = {a["name"].lower(): a["id_author"] for a in artists}

for t in tracks:

    # MAIN ARTIST
    bridge_rows.append({
        "SongID_Original": t["id"],
        "ArtistID_Original": t["id_artist"]
    })

    featured = t.get("featured_artists")

    if featured and isinstance(featured, str):

        # split su virgola
        feats = [x.strip() for x in featured.split(",")]

        for name in feats:
            f_id = name_to_id.get(name.lower())
            if f_id:
                bridge_rows.append({
                    "SongID_Original": t["id"],
                    "ArtistID_Original": f_id
                })


# ===========================================================
# SCRITTURA CSV
# ===========================================================

write_csv(f"{OUTPUT_PATH}\\DimArtistGeography.csv",
          ["BirthCity","BirthRegion","BirthCountry","Latitude","Longitude"],
          dim_artist_geo_rows)

write_csv(f"{OUTPUT_PATH}\\DimArtist.csv",
          ["ArtistID_Original","ArtistName","Gender","BirthDate","BirthPlace",
           "Nationality","Description","ActiveStartDate","ActiveEndDate","Type","ArtistGeoKey"],
          dim_artist_rows)

write_csv(f"{OUTPUT_PATH}\\DimAlbum.csv",
          ["AlbumID_Original","AlbumName","AlbumType","AlbumReleaseDate"],
          dim_album_rows)

write_csv(f"{OUTPUT_PATH}\\DimDate.csv",
          ["FullDate","Day","Month","MonthName","Year","Season"],
          dim_date_rows)

write_csv(f"{OUTPUT_PATH}\\FactPublishedSong.csv",
          ["SongID_Original","ArtistID_Original","AlbumID_Original","FullDate",
           "SongTitle","Language","DurationMS","Explicit","Popularity","TrackNumber",
           "Category","LyricsText","NSentences","NTokens","CharPerToken","AvgTokenPerClause",
           "Swear_IT","Swear_EN","Swear_IT_Words","Swear_EN_Words","BPM","RMS","Pitch",
           "SpectralComplexity","Loudness","Rolloff","Flux","Flatness","StreamsAfter1Month"],
          fact_rows)

write_csv(f"{OUTPUT_PATH}\\BridgeSongArtist.csv",
          ["SongID_Original","ArtistID_Original"],
          bridge_rows)

print("\n\nCSV GENERATI CORRETTAMENTE PER ASSIGNMENT 5\n")
