def load_fact(rows, song_map, artist_map, date_map):
    missing_song = 0
    missing_artist = 0
    missing_date = 0
    count = 0

    for r in rows:
        sk = song_map.get(r["SongID_Original"])
        ak = artist_map.get(r["ArtistID_Original"])
        dk = date_map.get(r["FullDate"])

        if sk is None:
            missing_song += 1
            continue
        if ak is None:
            missing_artist += 1
            continue
        if dk is None:
            missing_date += 1
            continue

        safe_execute("""
            INSERT INTO FactParticipation
            (SongKey, ArtistKey, DateKey, SymphonyKey, LyricsKey,
             StreamsAfter1Month, IsPrimary)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """,
        (
            sk, ak, dk,
            None, None,
            safe_int(r["StreamsAfter1Month"]),
            safe_int(r["IsPrimary"])
        ))

        count += 1
        if count % 100 == 0:
            conn.commit()

    conn.commit()
    print("✔ FactParticipation caricata")
    print("Missing Song:", missing_song)
    print("Missing Artist:", missing_artist)
    print("Missing Date:", missing_date)


