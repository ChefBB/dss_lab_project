#   2) FUNZIONE PER LEGGERE CSV (NO PANDAS)


def read_csv(path):
    with open(path, newline='', encoding='utf-8') as f:
        reader = csv.DictReader(f)
        return list(reader)



#   3) DIMENSIONE: ARTIST GEOGRAPHY


def load_dim_artist_geography(rows):

    # Colonne (province, region, country, latitude, longitude, geohash5)
    # → 6 colonne → 6 "?"
    for r in rows:
        cursor.execute("""
            INSERT INTO DimArtistGeography
            (Province, Region, Country, Latitude, Longitude, GeoHash5)
            VALUES (?, ?, ?, ?, ?, ?)
        """,
        # ?1 = Province
        r["province"],
        # ?2 = Region
        r["region"],
        # ?3 = Country
        r["country"],
        # ?4 = Latitude
        r["latitude"],
        # ?5 = Longitude
        r["longitude"],
        # ?6 = GeoHash5
        r["geohash5"]
        )

    conn.commit()
    print("✔ DimArtistGeography caricata")



#   4) LOOKUP PER GEOGRAPHY KEY (serve per DimArtist)


def get_artist_geo_map():
    cursor.execute("SELECT ArtistGeoKey, Province, Region, Country FROM DimArtistGeography")
    mapping = {}
    for key, prov, reg, country in cursor.fetchall():
        mapping[(prov, reg, country)] = key
    return mapping



#   5) DIMENSIONE: ARTIST


def load_dim_artist(rows, geo_map):

    # 10 colonne → 10 "?"
    for r in rows:

        geo_key = geo_map.get((r["province"], r["region"], r["country"]))

        cursor.execute("""
            INSERT INTO DimArtist
            (ArtistID_Original, ArtistName, Gender, BirthDate, BirthPlace,
             Nationality, Description, ActiveStart, ActiveEnd, ArtistGeoKey)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """,
        # ?1 = ArtistID_Original
        r["artist_id_original"],
        # ?2 = ArtistName
        r["artist_name"],
        # ?3 = Gender
        r["gender"],
        # ?4 = BirthDate
        r["birth_date"],
        # ?5 = BirthPlace
        r["birth_place"],
        # ?6 = Nationality
        r["nationality"],
        # ?7 = Description
        r["description"],
        # ?8 = ActiveStart
        r["active_start"],
        # ?9 = ActiveEnd
        r["active_end"],
        # ?10 = ArtistGeoKey (lookup)
        geo_key
        )

    conn.commit()
    print("✔ DimArtist caricata")



#   6) DIMENSIONE: ALBUM


def load_dim_album(rows):
    # 5 colonne → 5 "?"
    for r in rows:
        cursor.execute("""
            INSERT INTO DimAlbum
            (AlbumID_Original, AlbumName, AlbumType, AlbumReleaseDate, DiscNumber)
            VALUES (?, ?, ?, ?, ?)
        """,
        # ?1
        r["id_album"],
        # ?2
        r["album_name"],
        # ?3
        r["album_type"],
        # ?4
        r["album_release_date"],
        # ?5
        r["disc_number"]
        )

    conn.commit()
    print("✔ DimAlbum caricata")



#   7) LOOKUP PER ALBUM KEY (serve per DimSong)


def get_album_map():
    cursor.execute("SELECT AlbumKey, AlbumID_Original FROM DimAlbum")
    return {id_album: key for key, id_album in cursor.fetchall()}



#   8) DIMENSIONE: SONG


def load_dim_song(rows, album_map):

    # Song ha 27 colonne → 27 "?"
    for r in rows:

        album_key = album_map.get(r["id_album"])

        cursor.execute("""
            INSERT INTO DimSong
            (SongID_Original, SongTitle, Language, LyricsText,
             Swear_IT, Swear_EN, Swear_IT_Words, Swear_EN_Words,
             NSentences, NTokens, CharPerToken, AvgTokenPerClause,
             BPM, Rolloff, Flux, RMS, Flatness, SpectralComplexity,
             Pitch, Loudness, DurationMS, Explicit, Popularity,
             TrackNumber, Category, AlbumKey)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """,
        r["song_id_original"], r["title"], r["language"], r["lyrics"],
        r["swear_it"], r["swear_en"], r["swear_it_words"], r["swear_en_words"],
        r["n_sentences"], r["n_tokens"], r["char_per_tok"], r["avg_token_per_clause"],
        r["bpm"], r["rolloff"], r["flux"], r["rms"], r["flatness"], r["spectral_complexity"],
        r["pitch"], r["loudness"], r["duration_ms"], r["explicit"], r["popularity"],
        r["track_number"], r["category"], album_key
        )

    conn.commit()
    print("✔ DimSong caricata")



#   9) DIMENSIONE: DATE


def load_dim_date(rows):

    # 6 colonne → 6 "?"
    for r in rows:
        cursor.execute("""
            INSERT INTO DimDate
            (FullDate, Day, Month, MonthName, Year, Season)
            VALUES (?, ?, ?, ?, ?, ?)
        """,
        r["full_date"], r["day"], r["month"],
        r["month_name"], r["year"], r["season"]
        )

    conn.commit()
    print("✔ DimDate caricata")



#   10) LOOKUP SONG, ARTIST, DATE per FACT e BRIDGE


def get_song_map():
    cursor.execute("SELECT SongKey, SongID_Original FROM DimSong")
    return {id_song: key for key, id_song in cursor.fetchall()}

def get_artist_map():
    cursor.execute("SELECT ArtistKey, ArtistID_Original FROM DimArtist")
    return {id_artist: key for key, id_artist in cursor.fetchall()}

def get_date_map():
    cursor.execute("SELECT DateKey, FullDate FROM DimDate")
    return {date: key for key, date in cursor.fetchall()}



#   11) FACT PUBLISHED SONG


def load_fact(rows, song_map, artist_map, date_map):

    # 4 colonne → 4 "?"
    for r in rows:

        cursor.execute("""
            INSERT INTO FactPublishedSong
            (SongKey, ArtistKey, DateKey, StreamsAfter1Month)
            VALUES (?, ?, ?, ?)
        """,
        song_map.get(r["song_id"]),
        artist_map.get(r["artist_id"]),
        date_map.get(r["date"]),
        r["streams"]
        )

    conn.commit()
    print("✔ FactPublishedSong caricata")



#   12) BRIDGE SONG–ARTIST


def load_bridge(rows, song_map, artist_map):

    # 3 colonne → 3 "?"
    for r in rows:
        cursor.execute("""
            INSERT INTO BridgeSongArtist
            (SongKey, ArtistKey, Role)
            VALUES (?, ?, ?)
        """,
        song_map.get(r["song_id"]),
        artist_map.get(r["artist_id"]),
        r["role"]
        )

    conn.commit()
    print("✔ BridgeSongArtist caricata")



#   13) MAIN: esecuzione completa in ordine corretto


def main():

    print("\n=== LETTURA CSV ===")
    geo = read_csv("DimArtistGeography.csv")
    artist = read_csv("DimArtist.csv")
    album = read_csv("DimAlbum.csv")
    song = read_csv("DimSong.csv")
    date = read_csv("DimDate.csv")
    fact = read_csv("FactPublishedSong.csv")
    bridge = read_csv("BridgeSongArtist.csv")

    print("\n=== CARICAMENTO DIMENSIONI ===")
    load_dim_artist_geography(geo)

    geo_map = get_artist_geo_map()
    load_dim_artist(artist, geo_map)

    load_dim_album(album)

    album_map = get_album_map()
    load_dim_song(song, album_map)

    load_dim_date(date)

    print("\n=== CARICAMENTO FACT ===")
    song_map = get_song_map()
    artist_map = get_artist_map()
    date_map = get_date_map()

    load_fact(fact, song_map, artist_map, date_map)

    print("\n=== CARICAMENTO BRIDGE ===")
    load_bridge(bridge, song_map, artist_map)

    print("\n✔✔✔ TUTTO CARICATO NEL DATA WAREHOUSE ✔✔✔")


main()
