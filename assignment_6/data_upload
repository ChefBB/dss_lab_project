# =====================================================================
# 2) CHECK SE UNA TABELLA È VUOTA
# =====================================================================

def table_is_empty(table):
    """Ritorna True se la tabella è vuota o non esiste."""
    try:
        cursor.execute(f"SELECT COUNT(*) FROM {table}")
        count = cursor.fetchone()[0]
        return count == 0
    except:
        return True  # tabella non esiste → consideriamola vuota


# =====================================================================
# 3) FUNZIONE PER CARICARE UN CSV NELLA TABELLA
# =====================================================================

def upload_csv(filename, table_name):

    file_path = os.path.join(CSV_DIR, filename)

    if not os.path.exists(file_path):
        print(f"❌ ERRORE: file {filename} NON trovato!\n")
        return

    # Evita ricaricamenti
    if not table_is_empty(table_name):
        print(f"⏩ La tabella {table_name} contiene già dati → salto.\n")
        return

    print(f"⬆ Caricamento CSV: {filename} → {table_name}")

    with open(file_path, "r", encoding="utf-8") as f:
        reader = csv.reader(f)
        cols = next(reader)  # header CSV

        n_cols = len(cols)
        placeholders = ",".join(["?"] * n_cols)

        query = f"INSERT INTO {table_name} ({','.join(cols)}) VALUES ({placeholders})"

        inserted = 0

        for row in reader:
            clean_row = [None if v in ("", "NULL") else v for v in row]

            try:
                cursor.execute(query, clean_row)
                inserted += 1

            except Exception as e:

                print("\n==================== ERRORE SQL ====================")
                print(f"TABELLA: {table_name}")
                print("RIGA PROBLEMATICA:")

                for c, v in zip(cols, clean_row):
                    print(f"  {c}: {v}")

                print("ERRORE SQL:")
                print(e)
                print("====================================================\n")
                # Non stoppiamo, continuiamo il caricamento

        conn.commit()
        print(f"✔ Inserite {inserted} righe in {table_name}\n")


# =====================================================================
# 4) CICLO DI CARICAMENTO
# =====================================================================

for csv_file, table_name in TABLES:
    upload_csv(csv_file, table_name)

