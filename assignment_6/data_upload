# ============================================================
# 2) EXECUTE ROBUSTO (GESTISCE ERRORE 10053)
# ============================================================

def safe_execute(query, params=None, retry=True):
    global conn, cursor

    try:
        if params:
            cursor.execute(query, params)
        else:
            cursor.execute(query)
    except pyodbc.OperationalError as e:
        if retry and "10053" in str(e):
            print("⚠️  Connessione persa. Riconnessione in corso...")
            time.sleep(1)
            conn, cursor = connect()

            # ritenta una sola volta
            return safe_execute(query, params, retry=False)
        else:
            raise


# ============================================================
# 3) FUNZIONI DI CONVERSIONE
# ============================================================

def safe_int(v):
    if v is None or v == "":
        return None
    try:
        return int(float(v))
    except:
        return None

def safe_float(v):
    if v is None or v == "":
        return None
    try:
        return float(v)
    except:
        return None

def safe_date(v):
    if not v or v.strip() == "":
        return None
    v = v.strip()
    if len(v) == 4 and v.isdigit():
        return None
    if len(v) == 10 and v[4] == "-" and v[7] == "-":
        return v
    return None


