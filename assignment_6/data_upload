    for r in rows:
        safe_execute("""
            INSERT INTO DimArtistGeography
            (Province, Region, Country, Latitude, Longitude)
            VALUES (?, ?, ?, ?, ?)
        """,
        (
            r["Province"] or None,
            r["Region"] or None,
            r["Country"] or None,
            safe_float(r["Latitude"]),
            safe_float(r["Longitude"])
        ))

        count += 1
        if count % 50 == 0:
