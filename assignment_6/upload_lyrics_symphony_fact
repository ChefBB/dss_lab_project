# ============================================================
# 6) CARICAMENTO DIMLYRICS
# ============================================================

def load_dim_lyrics(rows):
    print(" Inizio caricamento DimLyrics...")
    count = 0

    for r in rows:
        sk = song_map.get(r["SongID_Original"])
        if sk is None:
            print("⚠️ SongKey mancante in Lyrics:", r["SongID_Original"])
            continue

        safe_execute("""
            INSERT INTO DimLyrics
            (Language, Swear_IT, Swear_EN, Swear_IT_Words, Swear_EN_Words,
             NSentences, NTokens, CharPerToken, AvgTokenPerClause,
             Explicit, LyricsText, Description)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """,
        (
            r["Language"] or None,
            safe_int(r["Swear_IT"]),
            safe_int(r["Swear_EN"]),
            r["Swear_IT_Words"] or None,
            r["Swear_EN_Words"] or None,
            safe_int(r["NSentences"]),
            safe_int(r["NTokens"]),
            safe_float(r["CharPerToken"]),
            safe_float(r["AvgTokenPerClause"]),
            1 if r["Explicit"] == "True" else 0,
            r["LyricsText"] or None,
            r["Description"] or None
        ))

        count += 1
        if count % 500 == 0:
            print(f"➡ {count} lyrics caricate")
            conn.commit()

    conn.commit()
    print(f"✔ DimLyrics caricata ({count} righe)\n")


