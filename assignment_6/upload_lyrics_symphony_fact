# ============================================================
# 8) CARICAMENTO FACT PARTICIPATION
# ============================================================

def load_fact(rows):
    print(" Inizio caricamento FactParticipation...")
    count = 0
    missing_s = missing_a = missing_d = 0

    for r in rows:
        sk = song_map.get(r["SongID_Original"])
        ak = artist_map.get(r["ArtistID_Original"])
        dk = date_map.get(r["FullDate"])

        if sk is None:
            missing_s += 1
            continue
        if ak is None:
            missing_a += 1
            continue
        if dk is None:
            missing_d += 1
            continue

        safe_execute("""
            INSERT INTO FactParticipation
            (SongKey, ArtistKey, DateKey, SymphonyKey, LyricsKey,
             StreamsAfter1Month, IsPrimary)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """,
        (
            sk, ak, dk,
            None, None,  # Symphony/Lyrics non usati come FK
            safe_int(r["StreamsAfter1Month"]),
            safe_int(r["IsPrimary"])
        ))

        count += 1
        if count % 500 == 0:
            print(f"➡ {count} fact caricate")
            conn.commit()

    conn.commit()
    print("✔ FactParticipation caricata")
    print("   Missing Song:", missing_s)
    print("   Missing Artist:", missing_a)
    print("   Missing Date:", missing_d, "\n")


