# ============================================================
# 8) CARICAMENTO FACT PARTICIPATION
# ============================================================

def load_fact(rows):
    print("🚀 Inizio caricamento FactParticipation...\n")

    # serve dopo la creazione di lyrics e symphony
    lyrics_map = create_lyrics_key_map()
    symph_map  = create_symph_key_map()

    count = 0
    missing = {"song":0, "artist":0, "date":0}

    for r in rows:
        sk = song_map.get(r["SongID_Original"])
        ak = artist_map.get(r["ArtistID_Original"])
        dk = date_map.get(r["FullDate"])

        if sk is None:
            missing["song"] += 1
            continue
        if ak is None:
            missing["artist"] += 1
            continue
        if dk is None:
            missing["date"] += 1
            continue

        safe_execute("""
            INSERT INTO FactParticipation
            (SongKey, ArtistKey, DateKey, SymphonyKey, LyricsKey,
             StreamsAfter1Month, IsPrimary)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """,
        (
            sk,
            ak,
            dk,
            symph_map.get(sk),
            lyrics_map.get(sk),
            safe_int(r["StreamsAfter1Month"]),
            safe_int(r["IsPrimary"])
        ))

        count += 1
        if count % 300 == 0:
            print(f"➡ {count} righe caricate...")
            conn.commit()

    conn.commit()
    print(f"✔ FactParticipation caricata ({count} righe)")
    print("🔎 Missing:", missing, "\n")


