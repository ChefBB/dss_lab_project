# ============================================================
# 6) CARICAMENTO DIMLYRICS
# ============================================================

def load_dim_lyrics(rows):
    print("🚀 Inizio caricamento DimLyrics...\n")
    count = 0
    for r in rows:

        song_key = song_map.get(r["SongID_Original"])
        if not song_key:
            continue

        safe_execute("""
            INSERT INTO DimLyrics
            (SongKey, Language, Swear_IT, Swear_EN, Swear_IT_Words,
             Swear_EN_Words, NSentences, NTokens, CharPerToken,
             AvgTokenPerClause, Explicit, LyricsText, Description)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """,
        (
            song_key,
            r["Language"] or None,
            safe_int(r["Swear_IT"]),
            safe_int(r["Swear_EN"]),
            r["Swear_IT_Words"] or None,
            r["Swear_EN_Words"] or None,
            safe_int(r["NSentences"]),
            safe_int(r["NTokens"]),
            safe_float(r["CharPerToken"]),
            safe_float(r["AvgTokenPerClause"]),
            1 if r["Explicit"] == "True" else 0 if r["Explicit"] == "False" else None,
            r["LyricsText"] or None,
            r["Description"] or None
        ))

        count += 1
        if count % 300 == 0:
            print(f"➡ {count} righe caricate...")
            conn.commit()

    conn.commit()
    print(f"✔ DimLyrics caricata correttamente ({count} righe)\n")


