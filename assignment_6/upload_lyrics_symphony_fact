def map_song_keys():
    cursor.execute("SELECT SongKey, SongID_Original FROM DimSong")
    return {orig: key for key, orig in cursor.fetchall()}

def map_artist_keys():
    cursor.execute("SELECT ArtistKey, ArtistID_Original FROM DimArtist")
    return {orig: key for key, orig in cursor.fetchall()}

def map_date_keys():
    cursor.execute("SELECT DateKey, FullDate FROM DimDate")
    return {date: key for key, date in cursor.fetchall()}

