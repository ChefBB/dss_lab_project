# ============================================================
# 5) CREAZIONE MAPPE SURROGATE
# ============================================================

def create_song_map():
    cursor.execute("SELECT SongKey, SongID_Original FROM DimSong")
    return {orig: key for key, orig in cursor.fetchall()}

def create_artist_map():
    cursor.execute("SELECT ArtistKey, ArtistID_Original FROM DimArtist")
    return {orig: key for key, orig in cursor.fetchall()}

def create_date_map():
    cursor.execute("SELECT DateKey, FullDate FROM DimDate")
    return {date: key for key, date in cursor.fetchall()}

def create_lyrics_key_map():
    cursor.execute("SELECT LyricsKey, SongKey FROM DimLyrics")
    return {song: key for key, song in cursor.fetchall()}

def create_symph_key_map():
    cursor.execute("SELECT SymphonyKey, SongKey FROM DimSymphony")
    return {song: key for key, song in cursor.fetchall()}


