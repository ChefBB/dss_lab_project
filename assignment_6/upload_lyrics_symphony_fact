# ============================================================
# 2) SAFE EXECUTE (GESTIONE ERRORI DI CONNESSIONE)
# ============================================================

def safe_execute(query, params=None, retry=True):
    global conn, cursor

    try:
        if params is None:
            cursor.execute(query)
        else:
            cursor.execute(query, params)

    except pyodbc.OperationalError as e:
        if retry and ("10053" in str(e) or "10060" in str(e)):
            print("⚠️  Connessione persa, riconnessione...")
            time.sleep(1)
            conn, cursor = connect()
            return safe_execute(query, params, retry=False)
        else:
            raise


# ============================================================
# 3) FUNZIONI UTILI
# ============================================================

def read_csv(path):
    with open(path, encoding="utf-8") as f:
        return list(csv.DictReader(f))

def safe_int(v):
    if v is None or v == "":
        return None
    try:
        return int(float(v))
    except:
        return None

def safe_float(v):
    if v is None or v == "":
        return None
    try:
        return float(v)
    except:
        return None


