                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH StratifiedSongs AS (

SELECT *,

ROW_NUMBER() OVER (
PARTITION BY Category

ORDER BY NEWID()

) AS rn,

COUNT(*) OVER (

PARTITION BY Category

) AS cnt

FROM Group_ID_8.DimSong
)


SELECT *

FROM StratifiedSongs

WHERE rn &lt;= cnt * 0.3;</property>
