      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>/* ============================================================
   BASE SYSTEM CALCULATION
   ============================================================ */

CALCULATE; 


/* ============================================================
   WEIGHTED STREAMS
   (0.8 per Main Artist, 0.2 per Feat Artist)
   ============================================================ */
CREATE MEMBER CURRENTCUBE.[Measures].[Weighted Streams]
AS 
    IIF(
        [Dim Artist].[IsPrimary].CURRENTMEMBER.MEMBER_VALUE = 1,
        [Measures].[Streams1Month] * 0.8,
        [Measures].[Streams1Month] * 0.2
    ),
VISIBLE = 1; </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
  </Cubes>
