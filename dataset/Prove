import json
import xml.etree.ElementTree as ET

# PATH ASSOLUTI AI FILE ORIGINALI
TRACKS_PATH = r"C:/Users/Win10/OneDrive - Università degli Studi di Torino/Desktop/repo_dss/dss_lab_project/dataset/tracks.json"
ARTISTS_PATH = r"C:/Users/Win10/OneDrive - Università degli Studi di Torino/Desktop/repo_dss/dss_lab_project/dataset/artists.xml"

# NUOVI OUTPUT: versione "null_clean"
OUTPUT_TRACKS = r"C:/Users/Win10/OneDrive - Università degli Studi di Torino/Desktop/repo_dss/dss_lab_project/dataset/tracks_nullclean.json"
OUTPUT_ARTISTS = r"C:/Users/Win10/OneDrive - Università degli Studi di Torino/Desktop/repo_dss/dss_lab_project/dataset/artists_nullclean.json"


# ----------------------------------------------------
# FUNZIONI DI PULIZIA
# ----------------------------------------------------

def clean_value(v):
    """
    Trasforma valori mancanti in None.
    """
    if v is None:
        return None

    if isinstance(v, str):
        v_strip = v.strip()
        if v_strip == "" or v_strip.lower() in ["na", "n/a", "unknown", "null"]:
            return None
        return v_strip

    return v


def clean_recursive(obj):
    """
    Pulisce strutture annidate: dict, list, valori singoli.
    """
    if isinstance(obj, dict):
        return {k: clean_recursive(clean_value(v)) for k, v in obj.items()}

    elif isinstance(obj, list):
        return [clean_recursive(clean_value(x)) for x in obj]

    else:
        return clean_value(obj)


# ----------------------------------------------------
# PULIZIA TRACKS.JSON
# ----------------------------------------------------

def clean_tracks_json():
    print("Caricamento:", TRACKS_PATH)

    with open(TRACKS_PATH, "r", encoding="utf-8") as f:
        data = json.load(f)

    cleaned = clean_recursive(data)

    with open(OUTPUT_TRACKS, "w", encoding="utf-8") as f:
        json.dump(cleaned, f, indent=4, ensure_ascii=False)

    print("[OK] Creato:", OUTPUT_TRACKS)


# ----------------------------------------------------
# ARTISTS.XML → JSON + PULIZIA
# ----------------------------------------------------

def xml_to_dict(elem):
    """
    Converte un elemento XML in dizionario (ricorsivo).
    """
    d = {elem.tag: {} if elem.attrib else None}

    d_elem = d[elem.tag]

    text = (elem.text or "").strip()
    if text:
        d[elem.tag] = text

    children = list(elem)
    if children:
        d[elem.tag] = {}
        for child in children:
            child_dict = xml_to_dict(child)
            for k, v in child_dict.items():
                if k in d[elem.tag]:
                    if not isinstance(d[elem.tag][k], list):
                        d[elem.tag][k] = [d[elem.tag][k]]
                    d[elem.tag][k].append(v)
                else:
                    d[elem.tag][k] = v

    return d


def clean_artists_xml():
    print("Caricamento:", ARTISTS_PATH)

    tree = ET.parse(ARTISTS_PATH)
    root = tree.getroot()

    raw_dict = xml_to_dict(root)
    cleaned = clean_recursive(raw_dict)

    with open(OUTPUT_ARTISTS, "w", encoding="utf-8") as f:
        json.dump(cleaned, f, indent=4, ensure_ascii=False)

    print("[OK] Creato:", OUTPUT_ARTISTS)


# ----------------------------------------------------
# MAIN
# ----------------------------------------------------

if __name__ == "__main__":
    clean_tracks_json()
    clean_artists_xml()
