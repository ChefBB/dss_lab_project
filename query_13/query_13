WITH recent_songs AS (
    -- Only primary artists, last 3 years
    SELECT
        fp.SongKey,
        fp.ArtistKey,
        ds.Category,
        fp.Streams1Month AS streams
    FROM FactParticipation fp
    JOIN DimSong ds
        ON ds.SongKey = fp.SongKey
    JOIN DimDate d
        ON d.DateKey = fp.DateKey
    WHERE
        fp.IsPrimary = 1
        AND d.Year >= YEAR(GETDATE()) - 2
),

category_moments AS (
    -- Compute category-level statistics
    SELECT
        rs.*,
        COUNT(*) OVER (PARTITION BY Category) AS n,
        AVG(streams) OVER (PARTITION BY Category) AS avg_streams,
        STDEV(streams) OVER (PARTITION BY Category) AS stddev_streams
    FROM recent_songs rs
),

artist_category_flags AS (
    -- Determine if a song is trending
    SELECT
        cm.ArtistKey,
        cm.SongKey,
        cm.Category,
        CASE
            WHEN cm.n > 1
             AND cm.streams >
                 (
                     -- mean of other songs
                     ((cm.avg_streams * cm.n) - cm.streams) / (cm.n - 1)
                     +
                     -- stddev of other songs
                     SQRT(
                         (
                             (cm.stddev_streams * cm.stddev_streams)
                             * (cm.n - 1)
                             +
                             cm.avg_streams * cm.avg_streams
                             -
                             POWER(
                                 ((cm.avg_streams * cm.n) - cm.streams) / (cm.n - 1),
                                 2
                             )
                         )
                     )
                 )
            THEN 1
            ELSE 0
        END AS is_trending
    FROM category_moments cm
)

SELECT
    a.ArtistKey,
    a.Name,
    acf.Category,
    SUM(acf.is_trending) AS NumTrendingSongs,
    COUNT(acf.SongKey) AS TotalSongs,
    SUM(acf.is_trending) * 1.0 / COUNT(acf.SongKey) AS PctTrendingSongs
FROM artist_category_flags acf
JOIN DimArtist a
    ON a.ArtistKey = acf.ArtistKey
GROUP BY
    a.ArtistKey,
    a.Name,
    acf.Category
HAVING SUM(acf.is_trending) > 0
ORDER BY
    PctTrendingSongs DESC,
    NumTrendingSongs DESC;