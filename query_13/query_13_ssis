WITH recent_songs AS (
    -- Step 1: select only primary-artist participation rows for recent songs
    SELECT
        fp.SongKey,
        fp.ArtistKey,
        ds.Category,
        fp.Streams1Month AS streams
    FROM FactParticipation fp
    JOIN DimSong ds
        ON ds.SongKey = fp.SongKey
    JOIN DimDate d
        ON d.DateKey = fp.DateKey
    WHERE
        fp.IsPrimary = 1                     -- filter primary artists immediately
        AND d.Year >= YEAR(GETDATE()) - 2    -- last 3 calendar years
),

category_stats AS (
    -- Step 2: compute per-category 75th percentile and category counts
    SELECT DISTINCT
        Category,
        COUNT(*) OVER (PARTITION BY Category) AS song_count,
        PERCENTILE_CONT(0.75)
            WITHIN GROUP (ORDER BY streams)
            OVER (PARTITION BY Category) AS p75_streams
    FROM recent_songs
)

-- Step 3: select songs above the 75th percentile threshold for their category
SELECT
    a.ArtistKey,
    a.Name,
    rs.Category,
    COUNT(*) AS NumTopQuartileSongs
FROM recent_songs rs
JOIN category_stats cs
    ON rs.Category = cs.Category
JOIN DimArtist a
    ON a.ArtistKey = rs.ArtistKey
WHERE
    cs.song_count >= 4                      -- only categories with >=4 songs
    AND rs.streams >= cs.p75_streams       -- only top quartile streams
GROUP BY
    a.ArtistKey,
    a.Name,
    rs.Category
ORDER BY
    NumTopQuartileSongs DESC;
